generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist]
}

enum Vertical {
  DENTAL
  CLINIC
  SALON
  PHYSIO
  VET
  CHIRO
  NAILSPA
}

enum Plan {
  TRIAL
  STARTER
  PRO
}

enum Role {
  OWNER
  STAFF
}

enum Channel {
  WHATSAPP
  SIMULATOR
}

enum ConversationStatus {
  AI
  HUMAN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageRole {
  USER
  ASSISTANT
  TOOL
  STAFF
  SYSTEM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  AI
  MANUAL
}

enum ScheduledMessageStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  memberships  Membership[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

model Membership {
  userId    String
  orgId     String
  role      Role
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@id([userId, orgId])
  @@index([orgId])
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  vertical           Vertical
  timezone           String
  plan               Plan     @default(TRIAL)
  /// BrandVoice (see @ar/shared)
  brandVoice         Json     @default("{}")
  /// BookingRules (see @ar/shared)
  bookingRules       Json     @default("{}")
  /// Org-level opening hours: [{ weekday, startMinute, endMinute }] in local minutes; providers default to these
  businessHours      Json     @default("[]")
  /// WhatsAppConfig (see @ar/shared); null = simulator only
  whatsappConfig     Json?
  /// EscalationContact[] (see @ar/shared)
  escalationContacts Json     @default("[]")
  /// CalendarSyncConfig (see @ar/shared)
  calendarConfig     Json?
  onboardedAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  memberships       Membership[]
  locations         Location[]
  providers         Provider[]
  services          Service[]
  faqs              Faq[]
  holidays          Holiday[]
  blockedTimes      BlockedTime[]
  contacts          Contact[]
  conversations     Conversation[]
  bookings          Booking[]
  scheduledMessages ScheduledMessage[]
  analyticsEvents   AnalyticsEvent[]
}

model Location {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  providers Provider[]

  @@index([orgId])
}

model Provider {
  id           String            @id @default(cuid())
  orgId        String
  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locationId   String?
  location     Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name         String
  title        String?
  active       Boolean           @default(true)
  color        String?
  externalCalendarId String?
  services     ProviderService[]
  workingHours WorkingHours[]
  blockedTimes BlockedTime[]
  bookings     Booking[]
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([orgId])
}

model Service {
  id                  String            @id @default(cuid())
  orgId               String
  org                 Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  durationMinutes     Int
  bufferBeforeMinutes Int               @default(0)
  bufferAfterMinutes  Int               @default(0)
  priceCents          Int?
  currency            String            @default("USD")
  active              Boolean           @default(true)
  sortOrder           Int               @default(0)
  providers           ProviderService[]
  bookings            Booking[]

  @@index([orgId])
}

model ProviderService {
  providerId String
  serviceId  String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
}

/// Weekly template, local wall-clock minutes in the organization's timezone.
model WorkingHours {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  weekday     Int
  startMinute Int
  endMinute   Int

  @@index([providerId, weekday])
}

/// Provider-specific or org-wide blocked time (lunch, meetings, time off). UTC instants.
model BlockedTime {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  providerId String?
  provider   Provider?    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startAt    DateTime     @db.Timestamptz(3)
  endAt      DateTime     @db.Timestamptz(3)
  reason     String?

  @@index([orgId, startAt])
  @@index([providerId, startAt])
}

model Holiday {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD in the org timezone
  date  String
  name  String

  @@unique([orgId, date])
}

model Faq {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  question String
  answer   String
  keywords String[]     @default([])
  sortOrder Int         @default(0)

  @@index([orgId])
}

model Contact {
  id            String         @id @default(cuid())
  orgId         String
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phoneE164     String
  name          String?
  email         String?
  language      String?
  /// ContactMemory (see @ar/shared)
  memory        Json           @default("{}")
  optedOut      Boolean        @default(false)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  conversations Conversation[]
  bookings      Booking[]
  scheduledMessages ScheduledMessage[]

  @@unique([orgId, phoneE164])
}

model Conversation {
  id               String             @id @default(cuid())
  orgId            String
  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel          Channel
  status           ConversationStatus @default(AI)
  handoffReason    String?
  handoffAt        DateTime?          @db.Timestamptz(3)
  assignedUserId   String?
  externalThreadId String?
  /// EngineState (see @ar/core): offered slots, pending qualification, etc.
  engineState      Json               @default("{}")
  summary          String?
  lastInboundAt    DateTime?          @db.Timestamptz(3)
  lastMessageAt    DateTime?          @db.Timestamptz(3)
  lastMessagePreview String?
  unreadCount      Int                @default(0)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  messages         Message[]
  bookings         Booking[]

  @@index([orgId, status, lastMessageAt])
  @@index([contactId])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  role              MessageRole
  /// Anthropic content blocks (text | tool_use | tool_result); staff/system messages use a single text block
  content           Json
  /// Denormalised plain text for display and search
  text              String?
  /// Quick-reply buttons attached to an outbound message
  buttons           Json?
  templateName      String?
  providerMessageId String?
  deliveryStatus    String?
  authorUserId      String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([conversationId, providerMessageId])
  @@index([conversationId, createdAt])
}

model Booking {
  id             String        @id @default(cuid())
  orgId          String
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  providerId     String
  provider       Provider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         BookingStatus @default(CONFIRMED)
  source         BookingSource
  /// Customer-facing appointment window
  startAt        DateTime      @db.Timestamptz(3)
  endAt          DateTime      @db.Timestamptz(3)
  /// Window including service buffers; the exclusion constraint is on this range
  busyStartAt    DateTime      @db.Timestamptz(3)
  busyEndAt      DateTime      @db.Timestamptz(3)
  notes          String?
  confirmedByCustomerAt DateTime? @db.Timestamptz(3)
  cancelledAt    DateTime?     @db.Timestamptz(3)
  cancelReason   String?
  externalCalendarEventId String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  scheduledMessages ScheduledMessage[]

  @@index([orgId, startAt])
  @@index([providerId, startAt])
  @@index([contactId, startAt])
}

model ScheduledMessage {
  id             String                 @id @default(cuid())
  orgId          String
  org            Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bookingId      String?
  booking        Booking?               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// CONFIRMATION | REMINDER_24H | REMINDER_2H | NO_SHOW_FOLLOWUP | REBOOK_NUDGE
  kind           String
  templateName   String
  templateParams Json
  runAt          DateTime               @db.Timestamptz(3)
  status         ScheduledMessageStatus @default(SCHEDULED)
  jobId          String                 @unique
  sentAt         DateTime?              @db.Timestamptz(3)
  error          String?
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)

  @@index([bookingId])
  @@index([orgId, runAt, status])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    Channel
  eventId     String
  payload     Json
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  error       String?

  @@unique([provider, eventId])
}

/// Append-only facts used by the analytics page. Types: CONVERSATION_STARTED, AI_REPLIED, BOOKING_CREATED,
/// BOOKING_RESCHEDULED, BOOKING_CANCELLED, BOOKING_CONFIRMED_BY_CUSTOMER, REMINDER_SENT, HANDOFF, HANDBACK
model AnalyticsEvent {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type           String
  conversationId String?
  bookingId      String?
  /// e.g. { firstResponseMs: 1200 }
  meta           Json         @default("{}")
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orgId, type, createdAt])
}
