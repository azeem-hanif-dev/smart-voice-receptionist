{
  "name": "@ar/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx scripts/prepare-test-db.ts && vitest run"
  },
  "dependencies": {
    "@ar/core": "workspace:*",
    "@ar/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "3.7.5",
    "@types/node": "22.20.1",
    "dotenv": "16.4.7",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
